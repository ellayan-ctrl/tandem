{
  "name": "twoway-stellar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && npm install",
    "dev": ".venv/bin/python -m backend --dev",
    "dev:client": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "start": ".venv/bin/python -m backend",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": ".venv/bin/python -m pytest -q",
    "test:contract": "cd soroban && cargo test",
    "deploy:contract": "scripts/deploy-contract.sh",
    "setup:treasury": ".venv/bin/python scripts/setup_treasury.py",
    "test:testnet": ".venv/bin/python scripts/testnet_demo.py"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3"
  }
}
