# Copy to .env.local (scripts/deploy-contract.sh and scripts/setup_treasury.py write these for you).
# Testnet only. Never commit real secrets.
OPERATOR_SECRET=S...                 # admin of the settlement contract; signs payout_remainder
SETTLEMENT_CONTRACT_ID=C...          # deployed twoway_settlement contract
USDC_CONTRACT_ID=C...                # testnet USDC Stellar Asset Contract
TREASURY_SECRET=S...                 # holds testnet USDC; stands in for the bank -> USDC on-ramp
# Optional
# PORT=3000  API_PORT=8000  DB_PATH=data/twoway.db  SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
